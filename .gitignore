# Dependencies
node_modules/

# Expo / React Native build artifacts
spike/mobile/.expo/
spike/mobile/dist/
spike/mobile/web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# PoC runtime state — the database and unpacked course content.
# Recreated by ./spike/demo reset
spike/data/
spike/backups/
spike/packages/
spike/packages.json

# SCORM test packages. Large binaries, freely re-downloadable from
# https://scorm.com/scorm-explained/technical-scorm/golf-examples/
spike/corpus/
*.zip
# Except our own Rise 360 exports — see spike/.gitignore. They cannot be
# re-downloaded, so a fresh clone needs the fixtures used by the demo.
!spike/corpus/Rise360_DiversityBasics_SCORM12.zip
!spike/corpus/Rise360_AngerManagement_SCORM12.zip
!spike/corpus/Rise360_AngerManagement_xAPI.zip

# The full session transcript as raw JSONL is 12MB of machine output.
# The readable version, docs/session/TRANSCRIPT.md, IS committed.
docs/session/transcript-raw.jsonl

# Local env / secrets
.env
.env.local

# How to reach the server, and what is on it. Hostnames, IPs, the shape of the
# firewall — none of it is a secret on its own, and all of it is a map for
# somebody who finds the repo. Kept beside the code so it is findable, kept out
# of the history so it is not published.
*.local.md

# macOS
.DS_Store

# Client requirements document — handled outside the repo
mytrackRequirementsAnalysis.pdf
*.pdf
spike/.env

# Test recordings dropped at the repo root while working on audio. The real
# corpus lives in spike/corpus; these are scratch and should not be history.
/*.m4a
/*.wav
