#!/usr/bin/env bash
#
# Waypoint PoC — demo control.
#
#   ./spike/demo start     start the servers (API, content, mock SaaS)
#   ./spike/demo mobile    start Metro and open the iOS simulator
#   ./spike/demo reset     wipe and re-seed (snapshots the old db first)
#   ./spike/demo restore   put the most recent snapshot back
#   ./spike/demo stop      stop the servers (leaves Metro alone)
#   ./spike/demo status    what is running, and the URLs
#
# The LAN address is detected each time and written into the mobile config,
# because a device cannot reach "localhost" and the IP changes with the network.

set -uo pipefail
cd "$(dirname "$0")/.."          # repo root — ingest uses paths relative to it

APP_PORT=8090
CONTENT_PORT=8091
SAAS_PORT=8092
# 8081, because the dev build looks there and nowhere else. Without
# expo-dev-client installed the app has no launcher screen and no deep-link
# handling, so the port cannot be told to it at run time — it is baked in.
# Override METRO_PORT if another Expo project is already holding 8081.
METRO_PORT=${METRO_PORT:-8081}
API_KEY=wp_demo_key_123
DATA_DIR=spike/data
# Two packages, deliberately different in kind:
#   golf       Rustici's reference sample — clean, minimal, spec-authored
#   diversity  a real Rise 360 export — 11MB, commits as it goes, writes
#              suspend_data. It found two bugs golf structurally could not.
SEED_ZIP=spike/corpus/RuntimeBasicCalls_SCORM12.zip
SEED_ZIP2=spike/corpus/Rise360_DiversityBasics_SCORM12.zip
LOG=/tmp/waypoint-demo.log
METRO_LOG=/tmp/waypoint-metro.log
# The app is a DEVELOPMENT BUILD, not Expo Go. Expo Go only ever supports the
# latest RELEASED SDK and cannot open this project — which is also why the
# microphone prompt shows our own wording rather than Expo Go's generic one.
BUNDLE_ID=com.waypoint.supervision

b()  { printf '\033[1m%s\033[0m\n' "$1"; }
ok() { printf '  \033[32m✓\033[0m %s\n' "$1"; }
no() { printf '  \033[31m✕\033[0m %s\n' "$1"; }
dim(){ printf '  \033[2m%s\033[0m\n' "$1"; }

lan_ip() {
  for i in en0 en1 en2; do
    ip=$(ipconfig getifaddr "$i" 2>/dev/null) && [ -n "$ip" ] && { echo "$ip"; return; }
  done
  echo "localhost"
}
HOST=$(lan_ip)

metro_up() { curl -fs -o /dev/null --max-time 2 "http://localhost:$METRO_PORT/status" 2>/dev/null; }

# Metro, once. Shared by `phone` and `sim` because it is the same bundle either
# way — only who fetches it changes. Started detached so the command never
# blocks the terminal and is safe to run repeatedly.
start_metro() {
  if metro_up; then ok "Metro already running on $METRO_PORT"; return 0; fi
  # --dev-client, because the app is a development build rather than Expo Go.
  # Without it Metro serves an Expo Go manifest, the dev build gets no script
  # URL, and the screen reads "No script URL provided" — which sounds like
  # Metro is down when it is running perfectly and answering the wrong question.
  (cd spike/mobile && nohup npx expo start --dev-client --port "$METRO_PORT" \
    >"$METRO_LOG" 2>&1 &) >/dev/null 2>&1
  for _ in $(seq 1 40); do metro_up && break; sleep 0.5; done
  if metro_up; then ok "Metro started on $METRO_PORT"; return 0; fi
  no "Metro would not start — last lines of $METRO_LOG:"
  tail -8 "$METRO_LOG" | sed 's/^/      /'
  return 1
}

servers_up() { curl -fs -o /dev/null --max-time 2 "http://$HOST:$APP_PORT/api/health" 2>/dev/null; }

stop_servers() {
  # kill -9 by PID. pkill has silently missed this process before, leaving a
  # server holding an unlinked database and serving stale data.
  local pids; pids=$(pgrep -f "spike/api/server.mjs" || true)
  [ -n "$pids" ] && { echo "$pids" | xargs kill -9 2>/dev/null; sleep 1; }
  pgrep -f "spike/api/server.mjs" >/dev/null && { no "servers would not stop"; return 1; }
  return 0
}

start_servers() {
  stop_servers || return 1
  # spike/.env holds the API keys, read by Node itself — no dotenv package,
  # which keeps the zero-dependency rule. Absent, the server still starts and
  # simply reports transcription and summarising as unavailable.
  #
  # Computed BEFORE the env-prefix line below: that line ends in a backslash,
  # and anything inserted between it and the command breaks the continuation.
  # The ports then never reach node, CONTENT_PORT silently falls back to its
  # 8081 default, and it collides with Metro — a failure that reads as a port
  # conflict and is really a line-continuation bug.
  local envfile=""
  [ -f spike/.env ] && envfile="--env-file=spike/.env"

  HOST=$HOST APP_PORT=$APP_PORT CONTENT_PORT=$CONTENT_PORT SAAS_PORT=$SAAS_PORT \
    WAYPOINT_API_KEY=$API_KEY nohup node $envfile spike/api/server.mjs >"$LOG" 2>&1 &
  for _ in $(seq 1 20); do servers_up && break; sleep 0.4; done
  if ! servers_up; then
    no "servers failed to start — last lines of $LOG:"
    grep -v Warning "$LOG" | tail -6 | sed 's/^/      /'
    return 1
  fi
  ok "servers running on $HOST"
}

ingest_one() {   # zip  program_id  title
  local code
  code=$(curl -s -o /dev/null -w '%{http_code}' -X POST "http://$HOST:$APP_PORT/api/ingest" \
    -H "Authorization: Bearer $API_KEY" -H 'Content-Type: application/json' \
    -d "{\"zip\":\"$1\",\"program_id\":\"$2\",\"title\":\"$3\"}")
  [ "$code" = "200" ] && ok "ingested — $3" \
                      || no "ingest failed (HTTP $code) — is $1 present?"
}

seed_content() {
  ingest_one "$SEED_ZIP"  golf-101      "Golf Explained (Rustici sample)"
  [ -f "$SEED_ZIP2" ] && ingest_one "$SEED_ZIP2" diversity-101 "Diversity Basics: Foundations (Rise 360)" \
                      || dim "no Rise export present — skipping diversity-101"

  # Assigning happens HERE and not in the JS seed, because the JS seed runs the
  # moment the server is listening and the content is not ingested until the
  # line above. Putting it there gave "no content ingested for golf-101" — the
  # ordering constraint is real, so it lives where the ordering is visible.
  #
  # One course assigned so the demo opens with a program in progress; the
  # second is left alone so the Assign flow is still worth showing.
  local code
  code=$(curl -s -o /dev/null -w '%{http_code}' -X POST "http://$HOST:$APP_PORT/api/assign" \
    -H "Authorization: Bearer $API_KEY" -H 'Content-Type: application/json' \
    -d '{"subject_id":"cust-2298","name":"Marcus Oyelaran","program_id":"golf-101"}')
  [ "$code" = "200" ] && ok "golf-101 assigned to Marcus Oyelaran" \
                      || dim "could not assign golf-101 (HTTP $code)"
}

sync_mobile_config() {
  # Only the fallback line. The app works its own host out from Metro at
  # runtime, which is what makes moving between networks a non-event; this is
  # for a build with no packager to ask.
  #
  # Rewriting the whole file, as this used to, meant every network change also
  # needed the app rebuilt — and the symptom was the app quietly talking to an
  # address that had not existed since the last coffee shop.
  local f=spike/mobile/config.js
  if [ -f "$f" ] && grep -q "^const WRITTEN_HOST" "$f"; then
    sed -i '' "s|^const WRITTEN_HOST = .*|const WRITTEN_HOST = \"$HOST\";|" "$f"
    ok "mobile fallback host set to $HOST (the app detects it live)"
  else
    no "spike/mobile/config.js is missing its WRITTEN_HOST line"
  fi
}

# Three surfaces, three DIFFERENT logins. Printing the URL without the login
# that goes with it is how you end up trying a subject's credentials on the
# staff console and being told, correctly, that they are wrong.
urls() {
  echo
  b "Where to go, and who to sign in as"
  printf '  %-14s %-38s %s\n' "Northwood"    "http://$HOST:$SAAS_PORT"          "r.alvarez@northwood.gov / northwood"
  dim   "                 the corrections system — STAFF only"
  printf '  %-14s %-38s %s\n' "Learner site" "http://$HOST:$APP_PORT/learn"     "cust-1041@example.com / northwood"
  dim   "                 where a SUBJECT takes their course"
  printf '  %-14s %-38s %s\n' "Waypoint"     "http://$HOST:$APP_PORT/console"   "no login"
  dim   "                 the LMS's own admin view"
  echo
  dim "  Subjects have no Northwood account — they sign in to Waypoint, and"
  dim "  Northwood asks Waypoint who they are. That is the design, not a gap."
  echo
}

script() {
  echo
  b "Already set up, so the demo does not open on empty screens"
  dim "Marcus Oyelaran address, vehicle, family, curfew, employment"
  dim "                3 fines — one overdue, one due next week"
  dim "                3 goals — one under way, one not started, one already met"
  dim "                supervision agreement — signed and issued, NOT acknowledged"
  dim "                reentry plan — 51/53 done, 2 checkpoints awaiting his signature"
  dim "                golf-101 assigned, not yet started"
  dim "                a visit TOMORROW, and 5 appointments across the week"
  dim "Dana Whitfield  on the same caseload, deliberately bare — so every empty"
  dim "                state and Create flow can be demonstrated"
  echo
  dim "Dana has nothing at all, and a second course is unassigned: those are"
  dim "the live parts."
  echo
  b "Demo script"
  dim "1. Northwood      Dana → Programs → assign Golf Explained"
  dim "2. Learner site   sign in, Start course, work through it, finish the quiz"
  dim "3. Northwood      the completion appears within a few seconds"
  echo
  dim "4. Northwood      subject → Visits → schedule one (address pre-filled,"
  dim "                  with a map link), then Start it and record observations"
  dim "5. Mobile app     the subject accepts the visit; the officer can also"
  dim "                  conduct it from the app, with notes and photographs"
  echo
  dim "6. Mobile app     Marcus opens it and owes two things:"
  dim "                    - acknowledge her conditions of supervision"
  dim "                    - sign off 2 reentry checkpoints"
  dim "7. Northwood      subject → Reentry Plan → the readiness dial goes to 100%"
  dim "                  and Certify complete turns from red to green"
  echo
  dim "Steps 6 and 7 are the argument: supervision is something the officer and"
  dim "the subject do together, and neither can complete a checkpoint alone."
  echo
  b "Logins"
  dim "Staff     r.alvarez@northwood.gov / northwood"
  dim "Subject   cust-1041@example.com   / northwood   (Dana Whitfield)"
  dim "          cust-2298@example.com   / northwood   (Marcus Oyelaran)"
  echo
  dim "These are seeded, so they survive ./spike/demo reset. A login created"
  dim "from a subject's profile shows its password once and is not repeatable."
  echo
}

case "${1:-start}" in

  start)
    b "Starting Waypoint demo"
    start_servers || exit 1
    [ -f "$DATA_DIR/waypoint.db" ] || seed_content
    sync_mobile_config
    urls; script
    dim "Mobile app:  ./spike/demo mobile"
    dim "Fresh slate: ./spike/demo reset"
    echo
    ;;

  reset)
    b "Resetting to a clean slate"
    stop_servers || exit 1
    # NOTE: the database lives in spike/data, NOT spike/api/data.
    #
    # Snapshot before destroying. A demo database holds things that cost real
    # time to produce — a course played to completion is fifteen minutes of
    # somebody clicking — and "reset" is one keystroke from "reset" typed by
    # mistake. Keep the last few; they are small and gitignored.
    if [ -f "$DATA_DIR/waypoint.db" ]; then
      mkdir -p "$DATA_DIR/../backups"
      snap="$DATA_DIR/../backups/waypoint-$(date +%Y%m%d-%H%M%S).db"
      cp "$DATA_DIR/waypoint.db" "$snap" 2>/dev/null \
        && ok "snapshot saved — $(basename "$snap")"
      # keep the five most recent
      ls -1t "$DATA_DIR/../backups"/waypoint-*.db 2>/dev/null | tail -n +6 | xargs rm -f 2>/dev/null
    fi
    rm -rf "$DATA_DIR"
    ok "all learners, registrations and completions deleted"
    start_servers || exit 1
    seed_content
    sync_mobile_config
    urls; script
    ;;

  restore)
    b "Restoring a snapshot"
    ls -1t "$DATA_DIR/../backups"/waypoint-*.db 2>/dev/null | head -5 | nl -w2 -s'  ' | sed 's/^/  /'
    latest=$(ls -1t "$DATA_DIR/../backups"/waypoint-*.db 2>/dev/null | head -1)
    if [ -z "$latest" ]; then no "no snapshots in spike/backups"; exit 1; fi
    stop_servers || exit 1
    mkdir -p "$DATA_DIR"
    cp "$latest" "$DATA_DIR/waypoint.db"
    ok "restored $(basename "$latest")"
    start_servers || exit 1
    urls
    ;;

  stop)
    b "Stopping"
    stop_servers && ok "servers stopped"
    pids=$(pgrep -f "expo start --port $METRO_PORT" || true)
    [ -n "$pids" ] && { echo "$pids" | xargs kill 2>/dev/null; ok "Metro stopped"; } \
                   || dim "Metro was not running"
    ;;

  phone|mobile|app)
    servers_up || { no "servers are not running — ./spike/demo start first"; exit 1; }
    sync_mobile_config
    b "Waypoint on your iPhone"
    start_metro || exit 1

    # The phone runs the development build we compiled onto it, so there is
    # nothing to open a URL in — it finds Metro over wifi by itself. All this
    # does is launch it, if the phone happens to be plugged in.
    dev=$(xcrun devicectl list devices 2>/dev/null | grep -i "available" \
          | grep -oE '[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}' \
          | head -1)
    if [ -n "$dev" ]; then
      xcrun devicectl device process launch --device "$dev" "$BUNDLE_ID" \
        >/dev/null 2>&1 && ok "Waypoint launched on your iPhone" \
        || dim "open Waypoint on the phone yourself — it will find Metro"
    else
      dim "no iPhone connected by cable — just open Waypoint on the phone"
    fi
    dim "the phone must be on the same wifi as this Mac ($HOST)"
    echo
    dim "Errors and console.log:  tail -f $METRO_LOG"
    dim "React Native DevTools:   press j in the Metro terminal"
    dim "Rebuild (native changes only, e.g. a new expo-* package):"
    dim "  cd spike/mobile && npx expo run:ios --device"
    echo
    ;;

  sim|simulator)
    servers_up || { no "servers are not running — ./spike/demo start first"; exit 1; }
    sync_mobile_config
    b "Waypoint in the iOS simulator"
    dim "note: the simulator cannot capture audio — recording produces silence"
    start_metro || exit 1

    # A booted simulator. Boot the first available iPhone if none is up.
    if ! xcrun simctl list devices | grep -q "(Booted)"; then
      dev=$(xcrun simctl list devices available \
            | grep -oE 'iPhone [^(]*\([0-9A-F-]{36}\)' | head -1 \
            | grep -oE '[0-9A-F-]{36}')
      [ -n "$dev" ] && xcrun simctl boot "$dev" 2>/dev/null
      open -a Simulator 2>/dev/null
      for _ in $(seq 1 30); do
        xcrun simctl list devices | grep -q "(Booted)" && break; sleep 1
      done
    fi
    xcrun simctl list devices | grep -q "(Booted)" \
      && ok "simulator booted" || { no "no simulator available"; exit 1; }
    open -a Simulator 2>/dev/null

    # The dev build, NOT Expo Go — Expo Go cannot open this project's SDK.
    #
    # Launched through the development-client URL rather than bare, because a
    # bare launch leaves the app waiting on whichever Metro it last saw. That
    # is usually 8081, the port `expo run:ios` starts for itself, and not the
    # 8082 this project uses — so the app sits on a blank screen looking for a
    # server that is not there. Naming the URL removes the guesswork.
    if xcrun simctl get_app_container booted "$BUNDLE_ID" >/dev/null 2>&1; then
      xcrun simctl terminate booted "$BUNDLE_ID" >/dev/null 2>&1
      sleep 1
      xcrun simctl openurl booted \
        "$BUNDLE_ID://expo-development-client/?url=http%3A%2F%2F$HOST%3A$METRO_PORT" \
        >/dev/null 2>&1 \
        && ok "Waypoint launched against Metro on $METRO_PORT" \
        || no "could not launch Waypoint"
    else
      no "Waypoint is not installed on this simulator"
      dim "build it once:  cd spike/mobile && npx expo run:ios"
      dim "Expo Go will not work — it only supports the latest released SDK"
    fi
    echo
    dim "Errors and console.log:  tail -f $METRO_LOG"
    echo
    ;;

  script|walkthrough)
    # Printed after start and reset, but worth having on demand — it is the
    # thing you read once more before hitting record.
    script
    ;;

  status)
    b "Waypoint demo status"
    servers_up && ok "servers up on $HOST" || no "servers down"
    metro_up && ok "Metro up on $METRO_PORT" || no "Metro down (./spike/demo mobile)"
    if servers_up; then
      python3 - "$HOST" "$APP_PORT" "$API_KEY" <<'PY'
import json, sys, urllib.request
host, app, key = sys.argv[1], sys.argv[2], sys.argv[3]

def get(path, k):
    """Northwood's routes need a staff session, which a shell script has no
    business holding. Ask Waypoint instead — the script already has its key."""
    r = urllib.request.Request(f"http://{host}:{app}{path}",
                               headers={"Authorization": f"Bearer {key}"})
    return json.load(urllib.request.urlopen(r, timeout=3))[k]

try:
    regs = get("/api/console/registrations", "registrations")
    done = [r for r in regs if r.get("completion_status") == "completed"]
    sent = [d for d in get("/api/console/deliveries", "deliveries")
            if d.get("status") == "delivered"]
    print(f"  \033[2mregistrations: {len(regs)}   completed: {len(done)}"
          f"   completions delivered: {len(sent)}"
          f"   catalog: {len(get('/api/content','content'))}\033[0m")
except Exception as e:
    print(f"  (couldn't read counts: {e})")
PY
    fi
    urls
    ;;

  *)
    b "Waypoint demo"
    dim "./spike/demo start    start the servers"
    dim "./spike/demo phone    Metro for your iPhone (the dev build)"
    dim "./spike/demo sim      Metro + the iOS simulator (no microphone)"
    dim "./spike/demo reset    wipe and re-seed for a fresh demo"
  dim "./spike/demo script   print the walkthrough"
    dim "./spike/demo stop     stop the servers"
    dim "./spike/demo status   what's running"
    echo
    ;;
esac
