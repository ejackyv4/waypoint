#!/usr/bin/env bash
# Privileged bridge for the web Demo Operations page.
# Install root-owned and allow only this file in sudoers; do not grant the
# application service user unrestricted sudo access.
set -euo pipefail
case "${1:-}" in
  status|clean)
    exec /usr/local/bin/waypoint-demo "$@"
    ;;
  reset)
    # A reset stops this application service. Run it in a transient systemd
    # unit outside waypoint.service, otherwise systemd kills the reset child
    # together with the web request's parent before it can restart the app.
    exec systemd-run --quiet --collect --unit=waypoint-demo-reset \
      /usr/local/bin/waypoint-demo reset --yes
    ;;
  *)
    echo "unsupported demo operation" >&2
    exit 2
    ;;
esac
