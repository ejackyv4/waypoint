# Copy to spike/.env and fill in. Never commit the real file.
#
# Transcription. Speaks the OpenAI audio API, which Groq and the self-hosted
# whisper servers also implement — so WAYPOINT_STT_URL is how you choose who
# hears the audio. For recordings of supervision conversations that is a real
# decision, not a detail.
WAYPOINT_STT_KEY=
# WAYPOINT_STT_URL=https://api.openai.com/v1/audio/transcriptions
# WAYPOINT_STT_MODEL=whisper-1

# Summary and action items.
WAYPOINT_LLM_KEY=
# WAYPOINT_LLM_MODEL=claude-sonnet-5
